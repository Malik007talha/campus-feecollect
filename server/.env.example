NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (include the database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/campus_feecollect?retryWrites=true&w=majority

# At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173


# Optional: email reminders (for Gmail, create an "App password" and use smtp.gmail.com / 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: SMS reminders (Twilio trial). A trial account can only text verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=


# Used only by "npm run seed:admin". Never commit real values.
SEED_ADMIN_PASSWORD=
SEED_ACCOUNTANT_PASSWORD=